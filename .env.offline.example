# FA Diagnosis System — INTERNAL NETWORK environment template
# ===========================================================
# For servers WITHOUT internet access
# Uses local Ollama model via Dify 1.15.0
#
# IMPORTANT: After installation, you MUST:
# 1. Login to Dify (http://localhost:80) - admin/admin123456
# 2. Configure Ollama model provider: http://ollama:11434
# 3. Create diagnosis workflow and get API key
# 4. Update DIFY_API_KEY below
# 5. Restart backend: docker compose restart backend
# =============================================================================

# --- FA backend → Dify workflow ---
# Inside Docker network, use the dify-nginx service name (not localhost)
DIFY_API_URL=http://dify-nginx:80
# IMPORTANT: Get this from your INTERNAL Dify instance after creating workflow
DIFY_API_KEY=
# Optional: Translate workflow API key
DIFY_TRANSLATE_API_KEY=

# FA SQLite (persisted in Docker volume fa_data → /app/data)
DATABASE_URL=sqlite:///data/fa_data.db

# --- Dify Configuration ---
DIFY_SECRET_KEY=sk-fa-dify-change-me-in-production
DIFY_INIT_PASSWORD=admin123456
CONSOLE_WEB_URL=http://localhost
CONSOLE_API_URL=http://localhost
SERVICE_API_URL=http://localhost
APP_WEB_URL=http://localhost
FILES_URL=http://localhost
SERVER_CONSOLE_API_URL=http://dify-api:5001

# --- PostgreSQL (Dify) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=difyai123456
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dify

# --- Redis (FA + Dify shared) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456

# --- Weaviate (vector DB for Dify) ---
WEAVIATE_API_KEY=WVF5YThaHlkYjkNmNTM

# --- Local LLM (Ollama) — Intranet deployment ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# --- Dify Plugin Daemon (required by Dify 1.15.0+) ---
DB_PLUGIN_DATABASE=dify_plugin
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DAEMON_URL=http://fa-plugin-daemon:5002
PLUGIN_DEBUGGING_HOST=0.0.0.0
PLUGIN_DEBUGGING_PORT=5003
EXPOSE_PLUGIN_DEBUGGING_HOST=localhost
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
PLUGIN_DIFY_INNER_API_URL=http://dify-api:5001
PLUGIN_DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=2000
PLUGIN_MAX_EXECUTION_TIMEOUT=2000

# --- Dify Sandbox (code execution & document parsing) ---
SANDBOX_API_KEY=dify-sandbox
SANDBOX_GIN_MODE=release
SANDBOX_WORKER_TIMEOUT=2000
SANDBOX_ENABLE_NETWORK=true
SANDBOX_HTTP_PROXY=http://ssrf-proxy:3128
SANDBOX_HTTPS_PROXY=http://ssrf-proxy:3128
SANDBOX_PORT=8194

# --- SSRF Proxy (plugin/sandbox external request proxy) ---
SSRF_HTTP_PORT=3128
SSRF_COREDUMP_DIR=/var/spool/squid
SSRF_REVERSE_PROXY_PORT=8194
SSRF_SANDBOX_HOST=dify-sandbox
SSRF_PROXY_HTTP_URL=http://ssrf-proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf-proxy:3128

# --- Timeout Settings (all 2000s for CPU-only LLM inference) ---
GUNICORN_TIMEOUT=2000
HTTP_REQUEST_TIMEOUT=2000
PLUGIN_DAEMON_TIMEOUT=2000
HTTP_REQUEST_MAX_READ_TIMEOUT=2000
HTTP_REQUEST_MAX_WRITE_TIMEOUT=2000
CODE_EXECUTION_READ_TIMEOUT=2000
LLM_REQUEST_TIMEOUT=2000
LLM_MAX_RETRY=2000
HTTP_REQUEST_MAX_RETRY=2000

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
